# =============================================================================
# 05_infra/local/.env.example — runtime local de PRODUCAO no PC do dono (DEC-57, T79)
#
# Lido SOMENTE por 05_infra/local/garra-local.ps1. O script copia este arquivo
# para 05_infra/local/.env no `setup` (se ainda nao existir) e preenche as
# chaves marcadas [gerado] com valores aleatorios, so quando estiverem vazias:
# um valor ja preenchido nunca e sobrescrito.
#
# O backend NAO le este arquivo direto: o script exporta cada chave como
# variavel de ambiente do processo (alembic, seeds e uvicorn rodam com o
# diretorio de trabalho em 05_infra/local/run/, entao o 04_backend/.env de
# desenvolvimento nunca e lido por engano).
#
# NUNCA versione o 05_infra/local/.env (coberto pelo padrao `.env` do .gitignore).
# Nao preencha valores reais neste .example.
# =============================================================================

# --- Aplicacao ------------------------------------------------------------------
# production liga as travas fail-closed de app/core/config.py (JWT >= 32 caracteres,
# CORS sem '*', DeepSeek exige chave).
ENVIRONMENT=production
# Front no GitHub Pages (repo publico garra-app, DEC-57 P3) + front local de desenvolvimento.
BACKEND_CORS_ORIGINS=https://rafaelroriz-age.github.io,http://localhost:3000
# O script roda `alembic upgrade head` antes de subir o uvicorn; nao repetir no boot.
RUN_MIGRATIONS_ON_STARTUP=false

# --- PostgreSQL 16 portatil (cluster em %LOCALAPPDATA%\garra\pgdata) --------------
# POSTGRES_USER e o superusuario do cluster dedicado (initdb -U).
POSTGRES_USER=garra
# [gerado] Somente hexadecimal: vai sem escape na URL do SQLAlchemy.
POSTGRES_PASSWORD=
POSTGRES_DB=garra_producao
POSTGRES_HOST=localhost
# 5434: nao colide com o Postgres do Docker de dev (5433) nem com instalacao nativa (5432).
POSTGRES_PORT=5434
# local = Postgres portatil acima (padrao). neon = Postgres gerenciado do Neon (DEC-58): o script nao
# baixa, nao sobe e nao derruba o Postgres portatil; `start` roda alembic contra o Neon e `status`
# testa a conexao. No modo neon, preencha NO .env LOCAL (nunca aqui, o repo e publico):
#   POSTGRES_HOST=<host da conexao DIRETA do Neon, SEM "-pooler" (asyncpg nao funciona com o pooler)>
#   POSTGRES_PORT=5432
#   POSTGRES_USER=<usuario do Neon>   POSTGRES_PASSWORD=<senha do Neon>   POSTGRES_DB=<banco do Neon>
#   POSTGRES_SSL=true
POSTGRES_MODO=local
# true = acrescenta ?ssl=require a URL do banco (obrigatorio no Neon). Falso no Postgres local.
POSTGRES_SSL=false
# Versao do zip de binarios da EDB baixado no setup (get.enterprisedb.com).
PG_VERSION=16.16

# --- JWT (RNF-05) -------------------------------------------------------------------
# [gerado] 96 caracteres hexadecimais.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage em disco (T80) ------------------------------------------------------------
# local = arquivos em disco servidos pelo proprio FastAPI com URL assinada (DEC-57 P6).
STORAGE_PROVEDOR=local
# Vazio = o script usa o caminho absoluto de 05_infra/local/storage.
STORAGE_LOCAL_DIR=
# URL publica do backend (tunel cloudflared, T82). Vazio = montada a partir do request.
PUBLIC_BASE_URL=

# --- Usuario auditor inicial (app/scripts/seed_admin.py, idempotente) --------------------
ADMIN_EMAIL=admin@garra-engenharia.com.br
ADMIN_NOME=Administrador
# [gerado] Troque no primeiro acesso; o seed nao altera usuario que ja existe.
ADMIN_SENHA=

# --- Snapshot cifrado do modo leitura (T81, DEC-57 P4) ---------------------------------------
# Senha da equipe: o DONO define (minimo 16 caracteres, HT-14). O setup deixa vazia de proposito.
SNAPSHOT_SENHA=

# --- Agente de inicializacao: tunel e publicacao (T82, DEC-57) --------------------------------
# Repo publico que recebe a branch `snapshot` (api.json + snapshot.enc), formato dono/repo.
GARRA_PUBLIC_REPO=rafaelroriz-age/garra-engenharia
# Opcional. Fine-grained PAT SOMENTE com Contents: read and write nesse repo. Nunca e logado nem
# gravado no .git/config. Vazio = usa a credencial git ja configurada no PC (Git Credential Manager).
GARRA_PUBLIC_TOKEN=
# Intervalos do laco do agente (minutos) e do tick de verificacao (segundos).
AGENTE_HEARTBEAT_MIN=10
AGENTE_SNAPSHOT_MIN=30
AGENTE_TICK_SEG=15

# --- Legenda por IA (B-04) -----------------------------------------------------------------
# fake | deepseek. Com deepseek em production a DEEPSEEK_API_KEY e obrigatoria.
LEGENDA_IA_PROVEDOR=fake
# Segredo: preencha so no .env local.
DEEPSEEK_API_KEY=

# --- WeasyPrint (PDF) no Windows ------------------------------------------------------------
# Pasta com libpango-1.0-0.dll e dependencias. Vazio = o script usa o MSYS2 portatil que o
# setup instala em %LOCALAPPDATA%\garra\msys64\ucrt64\bin (ou C:\msys64\ucrt64\bin, se existir).
WEASYPRINT_DLL_DIRECTORIES=

# --- Uvicorn e backup ------------------------------------------------------------------------------
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
# Quantos dumps garra-*.dump manter em 05_infra/local/backups/.
BACKUP_RETENCAO=14
