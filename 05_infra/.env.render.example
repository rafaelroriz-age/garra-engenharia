# =============================================================================
# 05_infra/.env.render.example — checklist de variáveis do serviço do Render
# (go-live, DEC-59). NÃO é lido por nenhum processo: copie os nomes para
# Render > garra-backend > Environment. Nunca commite valores reais.
# Referência: 04_backend/.env.example e `git show 20930f5^:render.yaml`.
# =============================================================================

# --- Obrigatórias -------------------------------------------------------------
ENVIRONMENT=production
RUN_MIGRATIONS_ON_STARTUP=true
# Origens do front, separadas por vírgula, sem path (CORS).
BACKEND_CORS_ORIGINS=https://rafaelroriz-age.github.io
# Postgres do Render (copie do Dashboard do banco: Internal Database).
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SSL=false
# Segredo do JWT: gere um valor longo e aleatório (ex.: openssl rand -hex 32).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage (Render Disk persistente) ------------------------------------------
STORAGE_PROVEDOR=local
# Caminho de montagem do Render Disk (o padrão do código é relativo ao repo e
# não serve em produção).
STORAGE_LOCAL_DIR=/var/data/storage
# URL pública do backend; vazio = montada do request.
PUBLIC_BASE_URL=https://garra-backend.onrender.com

# --- Opcionais (padrões iguais aos de config.py) ------------------------------------
LEGENDA_IA_PROVEDOR=fake
# Segredo, só se LEGENDA_IA_PROVEDOR=deepseek:
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELO=deepseek-flash
DEEPSEEK_TIMEOUT_S=30
DEEPSEEK_ENVIAR_IMAGEM=false
LEGENDA_IA_RAG_ATIVO=true
LEGENDA_IA_RAG_K=3
# Demais LEGENDA_IA_* (limites, cache): ver 04_backend/.env.example.

# --- Seed do gabarito e do admin (T110, DEC-59) -----------------------------------------
# Recomendado no go-live: roda gabarito + admin no boot, depois das migrations. Sem isso, o
# 1º POST /api/v1/auth/register (aberto enquanto não há usuários) vira auditor.
SEED_ON_STARTUP=true
# Obrigatória se SEED_ON_STARTUP=true (12+ caracteres, diferente da senha padrão de dev).
# Segredo: preencher só no painel do Render, nunca aqui.
ADMIN_SENHA=
ADMIN_EMAIL=admin@garra-engenharia.com.br
# Alternativa manual (Shell do Render, se SEED_ON_STARTUP ficar false):
# ADMIN_EMAIL=... ADMIN_SENHA=... python -m app.scripts.seed_admin
