# =============================================================================
# 05_infra/.env.render.example
#
# Referência das variáveis de ambiente usadas no deploy de PRODUÇÃO no Render
# (ver ../render.yaml). Diferente de `05_infra/.env.example` (usado só pelo
# `docker compose` local), este arquivo NÃO é lido por nenhum processo — o
# Render não usa um arquivo `.env` de verdade, as variáveis são cadastradas
# no Blueprint (`render.yaml`) ou manualmente no Dashboard
# (Settings → Environment de cada serviço).
#
# Use este arquivo como CHECKLIST ao revisar/editar as env vars no Dashboard.
# Nunca preencha valores reais aqui nem versione um arquivo com segredos.
# =============================================================================

# -----------------------------------------------------------------------------
# garra-backend (serviço web FastAPI)
# -----------------------------------------------------------------------------
# Gerenciadas automaticamente pelo Blueprint (render.yaml) — não precisa mexer:
ENVIRONMENT=production
POSTGRES_HOST=            # fromDatabase: garra-db.host
POSTGRES_PORT=            # fromDatabase: garra-db.port
POSTGRES_USER=            # fromDatabase: garra-db.user
POSTGRES_PASSWORD=        # fromDatabase: garra-db.password
POSTGRES_DB=              # fromDatabase: garra-db.database
JWT_SECRET_KEY=           # generateValue: true (gerado 1x pelo Render)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Precisa de revisão manual após o 1º deploy (o Render pode ter atribuído um
# hostname diferente do previsto em render.yaml, se "garra-frontend" já
# estivesse em uso por outra conta):
BACKEND_CORS_ORIGINS=https://garra-frontend.onrender.com

# FORA do escopo deste Blueprint (backend sobe sem storage funcional até
# alguém preencher isto manualmente no Dashboard — ver render.yaml comentado):
MINIO_HOST=
MINIO_API_PORT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=relatorios-prediais
MINIO_USE_SSL=true

# -----------------------------------------------------------------------------
# garra-frontend (serviço web Next.js)
# -----------------------------------------------------------------------------
# BUILD TIME (embutida no bundle JS — mudar exige novo deploy, não só restart):
# Precisa de revisão manual após o 1º deploy do backend (mesmo motivo acima).
NEXT_PUBLIC_API_URL=https://garra-backend.onrender.com/api/v1

# -----------------------------------------------------------------------------
# garra-db (PostgreSQL gerenciado)
# -----------------------------------------------------------------------------
# Não requer .env — credenciais são geradas pelo Render na criação e expostas
# aos outros serviços via `fromDatabase` (ver acima). Disponíveis também em
# Dashboard → garra-db → Connect, incluindo a Internal/External Database URL.
