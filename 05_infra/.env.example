# =============================================================================
# 05_infra/.env.example
# Copie este arquivo para 05_infra/.env e ajuste os valores para o seu ambiente.
#
#   cd 05_infra
#   cp .env.example .env
#
# NUNCA versione o arquivo .env (já está no .gitignore da raiz do repositório).
# Os valores abaixo são exemplos de desenvolvimento — troque as senhas antes
# de subir qualquer ambiente além do local.
# =============================================================================

# --- PostgreSQL (DEC-07) ---------------------------------------------------
POSTGRES_USER=garra
POSTGRES_PASSWORD=dev-postgres-troque-esta-senha
POSTGRES_DB=garra_engenharia
# Porta exposta em localhost para acesso via cliente SQL local (psql, DBeaver etc.).
# Padrão 5433 (não 5432) para evitar conflito com um PostgreSQL local já instalado.
POSTGRES_PORT=5433

# --- MinIO (DEC-02) ---------------------------------------------------------
MINIO_ROOT_USER=garra_admin
MINIO_ROOT_PASSWORD=dev-minio-troque-esta-senha
# Nome do bucket criado automaticamente pelo serviço `createbuckets`
MINIO_BUCKET_NAME=relatorios-prediais
# Porta da API S3-compatível (usada pelo backend via boto3)
MINIO_API_PORT=9000
# Porta do console web de administração (http://localhost:9001)
MINIO_CONSOLE_PORT=9001

# --- Backend FastAPI (DEC-05, BL-02) ----------------------------------------
# Porta em que a API escuta (uvicorn) e é publicada em localhost pelo compose.
BACKEND_PORT=8000
# Origens permitidas para CORS (separadas por vírgula) — frontend Next.js em dev.
BACKEND_CORS_ORIGINS=http://localhost:3000
# Chave secreta de assinatura dos tokens JWT (RNF-05) — gere uma chave própria
# por ambiente, nunca reutilize este valor de exemplo em produção.
JWT_SECRET_KEY=dev-jwt-secret-troque-esta-chave
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend Next.js (DEC-03/DEC-06, BL-03) --------------------------------
# Porta em que o `next dev` escuta e é publicada em localhost pelo compose.
FRONTEND_PORT=3000
# URL da API consumida pelo frontend (client-side, exposta via NEXT_PUBLIC_*).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
