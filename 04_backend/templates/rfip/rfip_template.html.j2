nter; vertical-align: top; border-right: 0.25pt solid #000000; border-bottom: 0.25pt solid #000000; border-left: 0.25pt solid #000000">{{ ocorrencia.descricao if ocorrencia.descricao not in (none, "") else "—" }}</td></tr>
