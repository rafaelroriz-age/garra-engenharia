<!DOCTYPE html>
{#
  ARQUIVO GERADO — não editar à mão. Produzido por `python -m app.scripts.build_rfip_templates` a partir de templates/rfip/layout.json (ADR-13/DEC-25).

  Layout derivado do original sha256 0465a67899996748… (aba fotográfica 'Rel. Fotográfico',
  120 linhas lidas). Ficha: 24 linhas,
  2 por página no original.
#}
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Relatório Fotográfico de Inspeção Predial</title>
<style>
  @page {
    size: A4 portrait;
    margin: 2.5cm 0.6cm 2.0cm 0.6cm;
    @top-right { content: element(logo); vertical-align: top; }
    @bottom-center { content: element(rodape); vertical-align: bottom; }
    @bottom-right { content: counter(page); vertical-align: bottom; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 10.0pt; }
  }
  @page resumo { margin: 2.0cm 1.3cm 2.0cm 1.3cm; }
  section.resumo { page: resumo; break-before: page; }
  table.resumo { width: 100%; border-collapse: collapse; table-layout: fixed; }
  table.resumo td, table.resumo th { padding: 1pt 2pt; overflow-wrap: anywhere; }
  body {
    font-family: 'Calibri', 'Carlito', sans-serif;
    font-size: 11.0pt;
    color: #000000;
    margin: 0;
  }
  .logo { position: running(logo); }
  .logo img { width: 4.59cm; height: 2.3cm; object-fit: contain; }
  .rodape { position: running(rodape); text-align: center; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 10.0pt; }
  .conteudo { margin-left: 0.36cm; }
  h2.sistema {
    font-family: 'Cambria', 'Caladea', serif;
    font-size: 11.0pt;
    font-weight: bold;
    text-align: left;
    height: 14.25pt;
    margin: 0 0 6.0pt 0;
    break-after: avoid;
  }
  table.ficha { width: 18.87cm; border-collapse: collapse; table-layout: fixed; break-inside: avoid; }
  table.ficha td { padding: 0 2pt; overflow: hidden; white-space: pre-line; }
</style>
</head>
<body>
  <div class="logo">{% if logo_data_uri %}<img src="{{ logo_data_uri }}" alt="Garra Engenharia">{% endif %}</div>
  <div class="rodape"><span style="color: #000000; font-weight: bold">{{ responsavel.nome }}</span><br><span style="color: #000000">{{ responsavel.titulo_profissional }} - CREA nº {{ responsavel.crea }}</span><br><span style="color: #4F81BD; font-weight: bold">{{ responsavel.email }}</span><span style="color: #000000"> / {{ responsavel.telefone }}</span></div>

  <main class="conteudo">
  {% for sistema in sistemas %}
  <section class="sistema">
    <h2 class="sistema">7.{{ loop.index }}. {{ sistema.nome }}</h2>
    {% for ocorrencia in sistema.ocorrencias %}
    <table class="ficha">
      <colgroup><col style="width: 6.08cm"><col style="width: 0.67cm"><col style="width: 8.12cm"><col style="width: 3.02cm"><col style="width: 0.98cm"></colgroup>
      <tbody>
        <tr style="height: 13.89pt"><td data-papel="titulo_foto" colspan="5" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 12.0pt; font-weight: bold; color: #000000; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">Foto nº {{ "%02d"|format(ocorrencia.seq_numero) }}</td></tr>
        <tr style="height: 13.89pt"><td data-papel="foto" rowspan="15" colspan="3" style="font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 10.0pt; color: #000000; text-align: center; vertical-align: top; border-top: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">{% if ocorrencia.foto_data_uri %}<img src="{{ ocorrencia.foto_data_uri }}" style="width: 13.78cm; height: 7.29cm; object-fit: contain" alt="Foto nº {{ ocorrencia.seq_numero }}">{% endif %}</td><td data-papel="rotulo" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; font-weight: bold; color: #000000; background: #D8D8D8; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">SITUAÇÃO</td></tr>
        <tr style="height: 13.89pt"><td data-papel="valor" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; color: #000000; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">{{ ocorrencia.situacao if ocorrencia.situacao not in (none, "") else "—" }}</td></tr>
        <tr style="height: 13.89pt"><td data-papel="rotulo" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; font-weight: bold; color: #000000; background: #D8D8D8; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">PRIORIDADE</td></tr>
        <tr style="height: 13.89pt"><td data-papel="rotulo" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 10.0pt; color: #000000; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">GRAVIDADE</td><td data-papel="valor" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 12.0pt; color: #000000; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">{{ ocorrencia.gut_gravidade if ocorrencia.gut_gravidade not in (none, "") else "—" }}</td></tr>
        <tr style="height: 13.89pt"><td data-papel="rotulo" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 10.0pt; color: #000000; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">URGÊNCIA</td><td data-papel="valor" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 12.0pt; color: #000000; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">{{ ocorrencia.gut_urgencia if ocorrencia.gut_urgencia not in (none, "") else "—" }}</td></tr>
        <tr style="height: 13.89pt"><td data-papel="rotulo" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 10.0pt; color: #000000; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">TENDÊNCIA</td><td data-papel="valor" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 12.0pt; color: #000000; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">{{ ocorrencia.gut_tendencia if ocorrencia.gut_tendencia not in (none, "") else "—" }}</td></tr>
        <tr style="height: 13.89pt"><td data-papel="rotulo" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; font-weight: bold; color: #000000; background: #D8D8D8; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">PONTUAÇÃO</td></tr>
        <tr style="height: 13.89pt"><td data-papel="valor" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; color: #FF0000; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">{{ ocorrencia.pontuacao_gut if ocorrencia.pontuacao_gut not in (none, "") else "—" }}</td></tr>
        <tr style="height: 13.89pt"><td data-papel="rotulo" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; font-weight: bold; color: #000000; background: #D8D8D8; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">CLASSIFICAÇÃO</td></tr>
        <tr style="height: 13.89pt"><td data-papel="valor" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; color: #000000; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">{{ ocorrencia.classificacao if ocorrencia.classificacao not in (none, "") else "—" }}</td></tr>
        <tr style="height: 23.39pt"><td data-papel="rotulo" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 9.0pt; font-weight: bold; color: #000000; background: #D8D8D8; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">TIPO DE {{ (ocorrencia.classificacao or "")|upper }}</td></tr>
        <tr style="height: 13.89pt"><td data-papel="valor" rowspan="2" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; color: #000000; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">{{ (ocorrencia.tipo_anomalia or ocorrencia.tipo_falha) if (ocorrencia.tipo_anomalia or ocorrencia.tipo_falha) not in (none, "") else "—" }}</td></tr>
        <tr style="height: 13.89pt"></tr>
        <tr style="height: 13.89pt"><td data-papel="rotulo" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 10.0pt; font-weight: bold; color: #000000; background: #D8D8D8; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">GRAU DE RISCO</td></tr>
        <tr style="height: 13.89pt"><td data-papel="valor" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; color: #000000; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-left: 0.5pt solid #000000">{{ ocorrencia.grau_risco if ocorrencia.grau_risco not in (none, "") else "—" }}</td></tr>
        <tr style="height: 13.89pt"><td data-papel="rotulo" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; font-weight: bold; color: #000000; background: #D8D8D8; text-align: center; vertical-align: top; border-top: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">SISTEMA</td><td data-papel="rotulo" colspan="3" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; font-weight: bold; color: #000000; background: #D8D8D8; text-align: left; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">OBSERVAÇÕES TÉCNICAS</td></tr>
        <tr style="height: 13.89pt"><td data-papel="valor" rowspan="2" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; color: #000000; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">{{ sistema.nome if sistema.nome not in (none, "") else "—" }}</td><td></td><td></td><td data-papel="vazio" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 10.0pt; vertical-align: middle; border-right: 0.5pt solid #000000"></td></tr>
        <tr style="height: 13.89pt"><td data-papel="valor" rowspan="5" colspan="3" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 10.0pt; text-align: center; vertical-align: middle; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">{{ ocorrencia.descricao if ocorrencia.descricao not in (none, "") else "—" }}</td></tr>
        <tr style="height: 13.89pt"><td data-papel="rotulo" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; font-weight: bold; color: #000000; background: #D8D8D8; text-align: center; vertical-align: top; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">SUBSISTEMA</td></tr>
        <tr style="height: 13.89pt"><td data-papel="valor" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; color: #000000; text-align: center; vertical-align: top; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">{{ ocorrencia.subsistema if ocorrencia.subsistema not in (none, "") else "—" }}</td></tr>
        <tr style="height: 13.89pt"><td data-papel="rotulo" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; font-weight: bold; color: #000000; background: #D8D8D8; text-align: center; vertical-align: top; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">LOCALIZAÇÃO</td></tr>
        <tr style="height: 13.89pt"><td data-papel="valor" colspan="2" style="font-family: 'Calibri', 'Carlito', sans-serif; font-size: 11.0pt; color: #000000; text-align: center; vertical-align: top; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">{{ ocorrencia.localizacao if ocorrencia.localizacao not in (none, "") else "—" }}</td></tr>
        <tr style="height: 13.89pt"><td></td><td></td><td></td><td></td><td></td></tr>
      </tbody>
    </table>
    {% endfor %}
  </section>
  {% endfor %}
  </main>

  {% if incluir_resumo %}
  <section class="resumo">
    <table class="resumo">
      <thead><tr><th style="width: 3.74%; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 14.0pt; font-weight: bold; color: #FFFFFF; background: #17365D; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">Imagem</th><th style="width: 4.49%; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 14.0pt; font-weight: bold; color: #FFFFFF; background: #17365D; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">Gravidade</th><th style="width: 4.02%; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 14.0pt; font-weight: bold; color: #FFFFFF; background: #17365D; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">Urgência</th><th style="width: 4.4%; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 14.0pt; font-weight: bold; color: #FFFFFF; background: #17365D; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">Tendência</th><th style="width: 4.46%; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 14.0pt; font-weight: bold; color: #FFFFFF; background: #17365D; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">Pontuação</th><th style="width: 5.17%; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 14.0pt; font-weight: bold; color: #FFFFFF; background: #17365D; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">Classificação</th><th style="width: 5.73%; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 14.0pt; font-weight: bold; color: #FFFFFF; background: #17365D; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">Tipo</th><th style="width: 3.94%; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 14.0pt; font-weight: bold; color: #FFFFFF; background: #17365D; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">Grau de Risco</th><th style="width: 9.72%; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 14.0pt; font-weight: bold; color: #FFFFFF; background: #17365D; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">Sistema</th><th style="width: 6.11%; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 14.0pt; font-weight: bold; color: #FFFFFF; background: #17365D; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">Subsistema</th><th style="width: 11.23%; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 14.0pt; font-weight: bold; color: #FFFFFF; background: #17365D; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">Localização</th><th style="width: 37.0%; font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 14.0pt; font-weight: bold; color: #FFFFFF; background: #17365D; text-align: center; vertical-align: middle; border-top: 0.5pt solid #000000; border-right: 0.5pt solid #000000; border-bottom: 0.5pt solid #000000; border-left: 0.5pt solid #000000">OBSERVAÇÕES TÉCNICAS</th></tr></thead>
      <tbody>
        {% for sistema in sistemas %}{% for ocorrencia in sistema.ocorrencias %}
        <tr><td style="font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 10.0pt; color: #000000; text-align: center; vertical-align: top; border-right: 0.25pt solid #000000; border-bottom: 0.25pt solid #000000; border-left: 0.25pt solid #000000">Foto nº {{ "%02d"|format(ocorrencia.seq_numero) }}</td><td style="font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 10.0pt; color: #000000; text-align: center; vertical-align: top; border-right: 0.25pt solid #000000; border-bottom: 0.25pt solid #000000; border-left: 0.25pt solid #000000">{{ ocorrencia.gut_gravidade if ocorrencia.gut_gravidade not in (none, "") else "—" }}</td><td style="font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 10.0pt; color: #000000; text-align: center; vertical-align: top; border-right: 0.25pt solid #000000; border-bottom: 0.25pt solid #000000; border-left: 0.25pt solid #000000">{{ ocorrencia.gut_urgencia if ocorrencia.gut_urgencia not in (none, "") else "—" }}</td><td style="font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 10.0pt; color: #000000; text-align: center; vertical-align: top; border-right: 0.25pt solid #000000; border-bottom: 0.25pt solid #000000; border-left: 0.25pt solid #000000">{{ ocorrencia.gut_tendencia if ocorrencia.gut_tendencia not in (none, "") else "—" }}</td><td style="font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 10.0pt; color: #000000; text-align: center; vertical-align: top; border-right: 0.25pt solid #000000; border-bottom: 0.25pt solid #000000; border-left: 0.25pt solid #000000">{{ ocorrencia.pontuacao_gut if ocorrencia.pontuacao_gut not in (none, "") else "—" }}</td><td style="font-family: 'Times New Roman', 'Liberation Serif', 'Tinos', serif; font-size: 10.0pt; color: #000000; text-align: center; vertical-align: top; border-right: 0.25pt solid #000000; border-bottom: 0.25pt solid #000000; border-left: 0.25pt solid #00000