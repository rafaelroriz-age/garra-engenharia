# =============================================================================
# 04_backend/Dockerfile.render
# Imagem de PRODUÇÃO do backend FastAPI, usada exclusivamente pelo deploy no
# Render (ver ../render.yaml). Não substitui `04_backend/Dockerfile` (imagem de
# DESENVOLVIMENTO com --reload, usada por `05_infra/docker-compose.yml`).
#
# Diferenças em relação ao Dockerfile de desenvolvimento:
#   - sem `--reload` (não há bind mount de código em produção);
#   - escuta na porta indicada por `$PORT` (Render injeta essa variável em
#     tempo de execução; padrão local 8000 se não definida);
#   - roda como usuário não-root (hardening básico de imagem).
# =============================================================================
FROM python:3.12-slim

# Bibliotecas de sistema exigidas pelo WeasyPrint para geração de PDF (DEC-01).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libcairo2 \
    libffi-dev \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN useradd --create-home --shell /usr/sbin/nologin appuser \
    && chown -R appuser:appuser /app

EXPOSE 8000

# Sem `USER appuser` aqui (T110): o disco persistente do Render é montado com dono root
# em tempo de execução. `render-start.sh` (root) só prepara STORAGE_LOCAL_DIR para o
# appuser e troca de usuário com `setpriv` antes do uvicorn, que nunca roda como root.
# O script expande ${PORT} (Render injeta a variável; padrão 8000).
CMD ["sh", "/app/render-start.sh"]
