# =============================================================================
# 04_backend/.env.example
# Uso local (fora de Docker): copie para 04_backend/.env e ajuste os valores.
#
#   cd 04_backend
#   cp .env.example .env
#
# Ao rodar via `docker compose` (05_infra/docker-compose.yml), este arquivo NÃO
# é necessário: as variáveis são injetadas diretamente no container pelo
# serviço `backend`, a partir de 05_infra/.env.
#
# NUNCA versione o arquivo .env (já está no .gitignore da raiz do repositório).
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
ENVIRONMENT=development
# Origens permitidas para CORS (separadas por vírgula) — frontend Next.js em dev.
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (DEC-07) -------------------------------------------------------
# Mesmas credenciais definidas em 05_infra/.env. Host "localhost" porque, fora
# de Docker, a conexão usa a porta publicada pelo docker-compose (05_infra).
POSTGRES_USER=garra
POSTGRES_PASSWORD=dev-postgres-troque-esta-senha
POSTGRES_DB=garra_engenharia
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MinIO (DEC-02) -------------------------------------------------------------
MINIO_ROOT_USER=garra_admin
MINIO_ROOT_PASSWORD=dev-minio-troque-esta-senha
MINIO_BUCKET_NAME=relatorios-prediais
MINIO_HOST=localhost
MINIO_API_PORT=9000
MINIO_USE_SSL=false

# --- JWT (RNF-05) -----------------------------------------------------------------
# Gere uma chave própria para cada ambiente — nunca reutilize este valor de exemplo.
JWT_SECRET_KEY=dev-jwt-secret-troque-esta-chave
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Legenda por IA: limites (DEC-42 C) -------------------------------------------
# Tentativas de geração por usuário na janela e por dia (janela fixa de 86400 s).
LEGENDA_IA_LIMITE_POR_USUARIO=10
LEGENDA_IA_JANELA_USUARIO_SEGUNDOS=60
LEGENDA_IA_LIMITE_DIARIO_POR_USUARIO=200
# Tentativas de geração por foto na janela, somando todos os usuários.
LEGENDA_IA_LIMITE_POR_FOTO=5
LEGENDA_IA_JANELA_FOTO_SEGUNDOS=3600
# Teto da saída do LLM. O máximo aceito para a sugestão é 500, o teto de `legenda`.
LEGENDA_IA_SAIDA_MAX_CARACTERES=500
LEGENDA_IA_SAIDA_MAX_ITENS=20
LEGENDA_IA_SAIDA_MAX_CARACTERES_ITEM=300

# --- Legenda por IA: provedor (B-04: DeepSeek Platform API) ------------------------
# fake (padrão, determinístico, sem rede) | deepseek. Em produção com deepseek a chave é obrigatória.
LEGENDA_IA_PROVEDOR=fake
# Segredo: nunca commitar valor real.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELO=deepseek-flash
DEEPSEEK_TIMEOUT_S=30
# true só se o modelo configurado aceitar imagem; false = modo texto (sem imagem).
DEEPSEEK_ENVIAR_IMAGEM=false
# Telemetria/cache local da legenda IA (BL-34, R-10). Preços em USD por 1M de tokens; vazio = custo null
# (preencher a partir da página oficial de preços da DeepSeek, tarefa IA-07).
LEGENDA_IA_CACHE_TTL_H=720
DEEPSEEK_PRECO_ENTRADA_CACHE_HIT_USD=
DEEPSEEK_PRECO_ENTRADA_CACHE_MISS_USD=
DEEPSEEK_PRECO_SAIDA_USD=
